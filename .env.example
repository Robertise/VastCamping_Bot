# Bắt buộc
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
VAST_API_KEY=your-vast-api-key

# Tùy chọn. Comment phải nằm trên dòng riêng, không để cùng dòng với giá trị.
# Số giây giữa 2 lần kiểm tra
CHECK_INTERVAL=60
# Đổi thành US để test vì máy VN hiếm
COUNTRY=VN
MIN_RELIABILITY=0.9
DB_PATH=bot.db
# Báo khi API lỗi liên tục quá 15 phút
ALERT_AFTER_SECONDS=900
# Để trống = ai cũng dùng được; ví dụ: 11111,22222
ALLOWED_CHAT_IDS=
